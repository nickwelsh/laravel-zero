{
    "name": "nickwelsh/laravel-zero",
    "description": "Laravel-owned model contracts, queries and CRUD for Rocicorp Zero.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0|^13.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.3",
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0|^11.0",
        "peckphp/peck": "^0.3.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "rector/rector": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "LaravelZero\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelZero\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelZero\\ZeroServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint",
        "format:check": "pint --test",
        "test:coverage": "pest --coverage"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
