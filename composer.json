{
  "name": "nickwelsh/laravel-zero",
  "description": "Laravel-owned model contracts, queries and CRUD for Rocicorp Zero.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0",
    "phpunit/phpunit": "^12.0",
    "laravel/pint": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "LaravelZero\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LaravelZero\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "LaravelZero\\ZeroServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit",
    "format": "pint",
    "format:check": "pint --test"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.3.0"
    }
  }
}
