includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/pestphp/pest/extension.neon

parameters:
    level: 6
    treatPhpDocTypesAsCertain: false
    phpVersion: 80300
    tmpDir: .cache/phpstan
    parseModelCastsMethod: true
    paths:
        - src
        - tests
